# ==============================================================================
# PROJECT ACS: Web ACS TR-069 + GIS Mapping + Remote Modem
# Environment Configuration Template
# Salin file ini menjadi .env dan sesuaikan nilainya: cp .env.example .env
# ==============================================================================

# Node Environment
NODE_ENV=production

# ------------------------------------------------------------------------------
# GENIEACS CONFIGURATION
# ------------------------------------------------------------------------------
GENIEACS_CWMP_ACCESS_LOG_FILE=/var/log/genieacs/genieacs-cwmp-access.log
GENIEACS_NBI_ACCESS_LOG_FILE=/var/log/genieacs/genieacs-nbi-access.log
GENIEACS_FS_ACCESS_LOG_FILE=/var/log/genieacs/genieacs-fs-access.log
GENIEACS_UI_ACCESS_LOG_FILE=/var/log/genieacs/genieacs-ui-access.log

# Kredensial CPE Auth (Username & Password yang diinput di Web ONT/Modem)
GENIEACS_CPE_USERNAME=acs_user
GENIEACS_CPE_PASSWORD=acs_password_secret_cpe

# Kredensial Connection Request yang dipush oleh ACS ke modem
GENIEACS_CR_USERNAME=cr_admin
GENIEACS_CR_PASSWORD=cr_secret_password_random

# URL Eksternal ACS (IP publik / IP VLAN manajemen server yang dijangkau modem)
# ⚠️  GANTI dengan IP aktual server Anda! Modem menggunakan URL ini untuk inform.
# Port CWMP: 7548 (sesuai deployment yang sudah berjalan)
# Contoh: GENIEACS_EXT_URL=http://203.0.113.50:7548/
GENIEACS_EXT_URL=http://GANTI_DENGAN_IP_SERVER_ANDA:7548/

# ------------------------------------------------------------------------------
# DATABASE & CACHE
# ------------------------------------------------------------------------------
# MongoDB (Khusus GenieACS)
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=genieacs
# MongoDB auth (WAJIB diganti sebelum production!)
MONGO_ROOT_USER=mongo_admin
MONGO_ROOT_PASSWORD=mongo_super_secret_change_me
GENIEACS_MONGODB_CONNECTION_URL=mongodb://mongo_admin:mongo_super_secret_change_me@mongo:27017/genieacs?authSource=admin

# PostgreSQL + PostGIS (Database Utama Backend)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=acs_db
POSTGRES_USER=acs_admin
POSTGRES_PASSWORD=postgres_super_secret_change_me
DATABASE_URL=postgresql://acs_admin:postgres_super_secret_change_me@postgres:5432/acs_db

# Redis (Job Queue BullMQ & Session Cache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ChangeMeSecureRedis2026!

# ------------------------------------------------------------------------------
# BACKEND API (NestJS) & CORS SECURITY
# ------------------------------------------------------------------------------
BACKEND_PORT=4000
BACKEND_INTERNAL_URL=http://backend:4000
GENIEACS_NBI_URL=http://genieacs-nbi:7557

# CORS: Daftar domain yang diizinkan mengakses REST API (pisahkan dengan koma)
# Jangan gunakan wildcard '*' di production!
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,https://acs.isp.net.id

# JWT Secret untuk Autentikasi Admin/NOC/Teknisi/CS
# WAJIB diganti dengan string acak dengan entropi tinggi sebelum production!
# Generate via CLI: openssl rand -base64 48
JWT_SECRET=super_secret_jwt_key_replace_with_random_64_chars_min
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_replace_with_random_64_chars
JWT_REFRESH_EXPIRES_IN=7d

# Password awal akun admin (dibuat otomatis jika belum ada user sama sekali)
# WAJIB diganti segera setelah login pertama!
# Jika tidak diset, default fallback adalah "admin123" (TIDAK AMAN untuk production)
ADMIN_INITIAL_PASSWORD=GantiPasswordIniSebelumProduction!

# ------------------------------------------------------------------------------
# FRONTEND & WEB SERVER
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
HTTP_PORT=80
HTTPS_PORT=443
DOMAIN_NAME=acs.local

# ------------------------------------------------------------------------------
# OLT COLLECTOR (Hioso & Hisfocus)
# ------------------------------------------------------------------------------
OLT_COLLECTOR_ENABLED=true
OLT_POLL_INTERVAL_MINUTES=3
OLT_MOCK_MODE=true

# ------------------------------------------------------------------------------
# ALERT & NOTIFICATIONS
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_OPTICAL_WARN_THRESHOLD=-25.0
ALERT_OPTICAL_CRITICAL_THRESHOLD=-27.0
